rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User Avatars: Public read for fast global display across web and mobile;
    // Strictly owner-only write, update, and delete access.
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default fallback: deny all other uploads
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
