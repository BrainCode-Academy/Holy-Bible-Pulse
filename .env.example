# -----------------------------------------------------------------------------
# Holy Bible+ Environment Configuration Template
# Set these variables in your Vercel Project Dashboard or production .env
# DO NOT commit real secrets or private credentials to GitHub.
# -----------------------------------------------------------------------------

# ==========================================
# [SERVER-SIDE ONLY SECRETS]
# ==========================================
# API.Bible key for licensed translations (leave empty to use built-in Public Domain engine)
API_BIBLE_KEY=

# JWT Secret for signing user authentication tokens (e.g. 64-char random hex string)
JWT_SECRET=

# Initial Administrator Credentials
ADMIN_EMAIL=admin@holybibleplus.app
ADMIN_INITIAL_PASSWORD=

# Google OAuth Client ID for server validation of Google tokens
GOOGLE_CLIENT_ID=

# Google Cloud / Firebase Firestore Server Configuration
FIRESTORE_PROJECT_ID=holy-bible-plus-60534
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_API_KEY=AIzaSyAOjFNqFIUbR3JfgLSBJ877JD0a9g_ztnw
FIRESTORE_APP_ID=1:453373691889:web:27545762e33ef53bbae650
FIRESTORE_AUTH_DOMAIN=holy-bible-plus-60534.firebaseapp.com
FIRESTORE_STORAGE_BUCKET=holy-bible-plus-60534.firebasestorage.app
FIRESTORE_MESSAGING_SENDER_ID=453373691889

# ==========================================
# [CLIENT-SIDE PUBLIC CONFIGURATION (Vite)]
# ==========================================
# Firebase Web Client Configuration (Built into frontend at build-time)
VITE_FIREBASE_API_KEY=AIzaSyAOjFNqFIUbR3JfgLSBJ877JD0a9g_ztnw
VITE_FIREBASE_AUTH_DOMAIN=holy-bible-plus-60534.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=holy-bible-plus-60534
VITE_FIREBASE_STORAGE_BUCKET=holy-bible-plus-60534.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=453373691889
VITE_FIREBASE_APP_ID=1:453373691889:web:27545762e33ef53bbae650
VITE_FIREBASE_MEASUREMENT_ID=G-F7VWYS3WPV

# Google Client ID for client Google Sign-In popup
VITE_GOOGLE_CLIENT_ID=

# Base URL used exclusively by standalone native Android APK build
# (In web deployments, leave blank to automatically use relative same-origin URLs)
VITE_API_BASE_URL=https://your-project.vercel.app
