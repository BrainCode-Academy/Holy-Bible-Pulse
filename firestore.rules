rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile documents: owner or admin can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'ADMIN');
      // Allow server-side admin SDK operations which bypass security rules
    }
    
    // User cloud synchronization data (bookmarks, highlights, notes, plans, prayer, settings)
    match /userSyncData/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'ADMIN');
    }

    // User avatar storage documents
    match /userAvatars/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'ADMIN');
    }

    // Analytics and telemetry events: server writes, admin reads
    match /analyticsEvents/{eventId} {
      allow read: if request.auth != null && request.auth.token.role == 'ADMIN';
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.role == 'ADMIN';
    }

    // Default catch-all: deny unauthorized access
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.role == 'ADMIN';
    }
  }
}
